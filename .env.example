# MongoDB 連線字串 (未指定 MONGODB_DB_NAME 時，NODE_ENV=production 連線至 AetherImmersion，開發環境預設連線至 AetherImmersion_dev)
MONGODB_URI=mongodb://127.0.0.1:27017/AetherImmersion

# 選填：自訂覆蓋目標資料庫名稱 (例如 AetherImmersion 或 AetherImmersion_dev)
# MONGODB_DB_NAME=AetherImmersion_dev

# Express API Port
PORT=5000

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=1000000000000-exampleclientid.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=1000000000000-exampleclientid.apps.googleusercontent.com
